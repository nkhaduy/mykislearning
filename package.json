{
  "type": "module",
  "scripts": {
    "lint": "eslint . --max-warnings 139",
    "lint:fix": "eslint . --fix",
    "typecheck": "npm run typecheck:legacy && npm run typecheck:worker && npm run typecheck:scripts",
    "typecheck:legacy": "tsc -p tsconfig.legacy.json",
    "typecheck:worker": "tsc -p tsconfig.worker.json",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "dev": "node scripts/start-local-development.mjs",
    "start:spa": "node scripts/spa-fallback-server.mjs",
    "build": "node scripts/build-static.mjs",
    "scan:artifact": "node scripts/scan-static-artifact.mjs dist",
    "check:bundle-budget": "node scripts/check-bundle-budget.mjs dist",
    "check:wrangler": "node scripts/check-wrangler-dry-run.mjs",
    "measure:route-bundles": "node scripts/measure-route-bundles.mjs",
    "check:legacy-monolith": "node scripts/check-legacy-monolith.mjs",
    "check:route-bundle-budget": "node scripts/check-route-bundle-budgets.mjs",
    "test:migrations": "node scripts/test-migrations.mjs all",
    "test:migrations:fresh": "node scripts/test-migrations.mjs fresh",
    "test:migrations:upgrade": "node scripts/test-migrations.mjs upgrade",
    "test:migrations:partial": "node scripts/test-migrations.mjs partial",
    "test:load:ephemeral": "node scripts/run-ephemeral-load-tests.mjs",
    "test:employee-search": "node scripts/test-employee-search-performance.mjs",
    "test:performance": "npm run test:employee-search",
    "test:reports": "node --test tests/unit/report-limits.test.mjs",
    "test:routes:all": "node --test tests/unit/route-registry-all.test.mjs tests/unit/route-split-navigation.test.mjs",
    "test:reports:100k": "node scripts/test-reports-postgres-100k.mjs",
    "test:reports:concurrency": "node scripts/test-reports-concurrency.mjs",
    "test:reports:timeout": "node scripts/test-reports-timeout.mjs",
    "test:exports:all": "node scripts/test-exports-all.mjs",
    "test:queue-dlq": "node scripts/test-queue-dlq.mjs",
    "replay:export-dlq:plan": "node scripts/replay-export-dlq.mjs",
    "test:r2-authorization": "node --test tests/unit/export-jobs.test.mjs",
    "check:search-rollout": "node scripts/check-search-rollout.mjs",
    "test:export-jobs": "node --test tests/unit/export-jobs.test.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:security": "node --test tests/security/*.test.mjs",
    "test:auth-rotation": "node --test tests/security/auth-hardening.test.mjs",
    "test:mfa": "node --test tests/security/mfa-removal.test.mjs",
    "test:rate-limit": "node --test tests/security/rate-limit-hardening.test.mjs",
    "test:session-security": "node --test tests/security/auth-hardening.test.mjs tests/security/auth-middleware.test.mjs",
    "staging:rehearsal:preflight": "node scripts/staging-rehearsal-preflight.mjs",
    "staging:verify-target": "node scripts/verify-staging-target.mjs",
    "staging:bootstrap": "node scripts/staging/bootstrap-staging.mjs",
    "staging:provision": "node scripts/staging/staging-command.mjs provision",
    "staging:deploy": "node scripts/staging/staging-command.mjs deploy",
    "staging:smoke": "node scripts/staging/staging-command.mjs smoke",
    "staging:integration": "node scripts/staging/integration-smoke.mjs",
    "staging:db-evidence": "node scripts/staging/capture-db-evidence.mjs",
    "staging:restore-drill": "node scripts/staging/database-restore-drill.mjs",
    "staging:rollback-drill": "node scripts/staging/staging-command.mjs rollback-drill",
    "staging:readiness": "node scripts/staging/staging-command.mjs readiness",
    "security:accept-no-mfa": "node scripts/security/accept-no-mfa.mjs",
    "production:gates": "node scripts/production/run-production-gates.mjs",
    "production:manifest": "node scripts/production/create-release-manifest.mjs",
    "production:runtime:finalize": "node scripts/production/finalize-secure-runtime.mjs",
    "production:plan": "node scripts/production/deploy-production.mjs",
    "production:deploy": "node scripts/production/deploy-production.mjs",
    "production:deploy-approved": "node scripts/production/deploy-production.mjs --apply",
    "production:emergency-runtime": "node scripts/production/create-emergency-recovery-runtime.mjs",
    "production:emergency-manifest": "node scripts/production/create-emergency-release-manifest.mjs",
    "production:emergency-plan": "node scripts/production/deploy-emergency-forward-recovery.mjs",
    "production:emergency-deploy-approved": "node scripts/production/deploy-emergency-forward-recovery.mjs --apply",
    "production:clean-reset:plan": "node scripts/production/clean-reset/production-clean-reset-plan.mjs",
    "production:clean-reset:apply-approved": "node scripts/production/clean-reset/production-clean-reset-apply.mjs --apply",
    "production:clean-reset:verify": "node scripts/production/clean-reset/production-clean-reset-verify.mjs",
    "production:clean-reset:rollback": "node scripts/production/clean-reset/production-clean-reset-rollback.mjs",
    "test:e2e:public": "PLAYWRIGHT_SUITE=public-readonly playwright test",
    "test:e2e:authenticated": "PLAYWRIGHT_SUITE=authenticated-readonly playwright test",
    "test:e2e:mutation": "PLAYWRIGHT_SUITE=mutation PLAYWRIGHT_ALLOW_MUTATION=true playwright test",
    "cf:dev": "npm run build && NODE_TLS_REJECT_UNAUTHORIZED=0 npx wrangler dev --env local --local",
    "cf:deploy": "npm run build && NODE_TLS_REJECT_UNAUTHORIZED=0 npx wrangler deploy"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "playwright": "^1.61.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "wrangler": "^4.114.0"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.1.3",
    "@supabase/supabase-js": "^2.108.2",
    "impeccable": "github:pbakaus/impeccable",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "allowScripts": {
    "puppeteer@25.1.0": true
  }
}
